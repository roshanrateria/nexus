# Copy this file to .env and fill in real values. NEVER commit .env.
# --- Endpoints ---
# cloud: Meta-hosted swap-in brain, text-only use (Muse Spark via Meta Model API).
# open:  OpenAI-compatible endpoint serving open-weights models (sees screenshots).
CLOUD_BASE_URL=https://replace-with-cloud-endpoint/v1
CLOUD_API_KEY=your-cloud-api-key
OPEN_BASE_URL=https://replace-with-open-endpoint/v1
OPEN_API_KEY=your-open-api-key
# with_structured_output extraction method: json_schema | function_calling | json_mode
STRUCTURED_METHOD=json_schema

# --- Roles ---
PLANNER_ENDPOINT=cloud
PLANNER_MODEL=your-cloud-model
EXECUTOR_ENDPOINT=open
EXECUTOR_MODEL=your-open-model
VERIFIER_ENDPOINT=open
VERIFIER_MODEL=your-open-model
REPORTER_ENDPOINT=cloud
REPORTER_MODEL=your-cloud-model

# --- Rate limiting and retry ---
RATE_LIMIT_RPM=35
LLM_MAX_ATTEMPTS=6
RETRY_INITIAL_SECONDS=2
RETRY_MAX_SECONDS=60

# --- Budgets ---
MAX_PLANNER_ROUNDS=40
MAX_STEP_ITERATIONS=25
# How often a step is retried locally (verifier -> executor) before the planner steps in.
MAX_LOCAL_RETRIES=2
# Per planner round the graph does roughly (MAX_LOCAL_RETRIES + 1) * (2 + 3 * MAX_STEP_ITERATIONS)
# supersteps now; keep this well above that product.
RECURSION_LIMIT=10000

# --- Observation and text limits ---
MAX_OBSERVATION_CHARS=12000
MAX_PAGE_TEXT_CHARS=15000
MAX_ARTIFACT_CHARS=40000
MAX_LINKS=60
VERIFIER_PAGE_TEXT_CHARS=12000
EVENT_TEXT_CHARS=300

# --- Browser ---
OBSERVATION_VIEWPORT_MARGIN=200
SCREENSHOT_QUALITY=60
ACTION_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=45000
SETTLE_MS=800
TYPING_DELAY_MS=40
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_DIR=.browser_profile_agent
BROWSER_VIEWPORT_WIDTH=1366
BROWSER_VIEWPORT_HEIGHT=800
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata
# Honest defaults: no spoofed headers, no anti-detection flags.
BROWSER_EXTRA_HEADERS={}
BROWSER_LAUNCH_ARGS=[]

# --- Storage and dashboard ---
CHECKPOINT_DB=checkpoints.sqlite
REPORTS_DIR=reports
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_OPEN=true
DASHBOARD_MAX_LOG=300

# --- Tool gating ---
# run_javascript is disabled unless explicitly enabled here.
ALLOW_RUN_JAVASCRIPT=false
