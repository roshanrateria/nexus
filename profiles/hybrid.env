# Hybrid default: Meta Spark plans and reports, open-weights hands on Baseten.
# Needs BASETEN_API_KEY in .env (see .env.example). Hybrid mode always runs the
# executor/verifier on the Baseten open-weights model regardless of EXECUTOR_MODEL/
# VERIFIER_MODEL; their MAX_TOKENS overrides still apply, and reasoning_effort is
# only sent to the Meta endpoint.
NEXUS_MODE=hybrid
PLANNER_MODEL=muse-spark-1.3
PLANNER_REASONING_EFFORT=high
PLANNER_MAX_TOKENS=8192
EXECUTOR_MODEL=meta-models/muse-spark-open-1026
EXECUTOR_REASONING_EFFORT=low
EXECUTOR_MAX_TOKENS=4096
VERIFIER_MODEL=meta-models/muse-spark-open-1026
VERIFIER_REASONING_EFFORT=low
VERIFIER_MAX_TOKENS=4096
REPORTER_MODEL=muse-spark-1.3
REPORTER_REASONING_EFFORT=medium
REPORTER_MAX_TOKENS=8192
