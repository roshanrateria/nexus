# Everything on the Meta Model API (cloud-only baseline: the same Bearer key
# as .env, screenshots are processed by the Meta Model API).
NEXUS_MODE=cloud
PLANNER_MODEL=muse-spark-1.3
PLANNER_REASONING_EFFORT=high
PLANNER_MAX_TOKENS=8192
EXECUTOR_MODEL=muse-spark-1.3
EXECUTOR_REASONING_EFFORT=low
EXECUTOR_MAX_TOKENS=4096
VERIFIER_MODEL=muse-spark-1.3
VERIFIER_REASONING_EFFORT=low
VERIFIER_MAX_TOKENS=4096
REPORTER_MODEL=muse-spark-1.3
REPORTER_REASONING_EFFORT=medium
REPORTER_MAX_TOKENS=8192
